# MongoDB connection string (do not commit real credentials)
MONGODB_URI=

# Secret used to sign JWTs - use a long random string, never commit a real one
JWT_SECRET=

# How long issued JWTs remain valid
JWT_EXPIRES_IN=7d

# Port the Express server listens on
PORT=5000

# URL of the frontend client, used for CORS
CLIENT_URL=http://localhost:5173

# Set to "production" on your hosting platform - enables stricter error
# responses (no internal error details are ever sent to the client)
NODE_ENV=development
